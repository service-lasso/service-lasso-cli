{
  "name": "@service-lasso/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Automation-first client for Service Lasso service authoring and Core operations.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "service-lassoctl": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/**/*.test.js tests/durable-operator-cli.test.js",
    "start": "node dist/index.js",
    "package:candidate": "node scripts/package-candidate.mjs",
    "smoke:candidate": "node scripts/smoke-candidate.mjs",
    "test:readback-shell": "node scripts/test-candidate-readback-shell.mjs",
    "package:native": "npm run build && node scripts/package-native.mjs",
    "smoke:native": "node scripts/smoke-native.mjs",
    "archive:native": "node scripts/archive-native-candidate.mjs",
    "assemble:protected-candidate": "node scripts/assemble-protected-candidate.mjs",
    "verify:protected-candidate": "node scripts/verify-protected-candidate.mjs",
    "publish:protected-candidate": "node scripts/publish-protected-candidate.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.7.0"
  }
}
